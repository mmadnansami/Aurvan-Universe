        "rank_id": { "type": "integer" },
        "rank_title": { "type": "string", "maxLength": 120 },
        "rank_order": { "type": "integer" },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"] },
        "bio": { "type": "string", "maxLength": 600 },
        "approved_cases_count": { "type": "integer" },
        "average_score": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "full_name",
        "player_code",
        "role",
        "institution_id",
        "institution_code",
        "institution_name",
        "rank_id",
        "rank_title",
        "rank_order",
        "status",
        "bio",
        "approved_cases_count",
        "average_score",
        "createdAt",
        "updatedAt"
      ]
    },
