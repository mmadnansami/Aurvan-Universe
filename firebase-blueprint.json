      "type": "object",
      "properties": {
        "ok": { "type": "boolean" }
      }
    },
    "PlatformBootstrap": {
      "title": "PlatformBootstrap",
      "description": "Public platform branding, site content, institutions, ranks, and eight Bangladesh divisions",
      "type": "object",
      "properties": {
        "settings": { "type": "object" },
        "content": { "type": "object" },
        "institutions": { "type": "array" },
        "ranks": { "type": "array" },
        "regions": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["settings", "content", "institutions", "ranks", "regions", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted Directorate admin privilege marker keyed by Firebase Auth UID",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["ADMIN", "SUPER_ADMIN"] },
        "email": { "type": "string", "maxLength": 254 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "email", "grantedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Operational investigator profile without PII (email isolated in private subcollection)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "full_name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "player_code": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["PLAYER", "ADMIN", "SUPER_ADMIN"] },
