# GEMINI_API_KEY: Optional for future AI utilities (not exposed to client).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Cryptographic secret for signing persistent session tokens (set in production).
SESSION_SECRET="change-this-to-a-strong-random-secret"

# BOOTSTRAP_ADMIN_EMAIL / BOOTSTRAP_ADMIN_PASSWORD:
# Initial Super Admin credentials used only during server bootstrap if no Super Admin exists yet.
BOOTSTRAP_ADMIN_EMAIL="muttakiadnansami@gmail.com"
BOOTSTRAP_ADMIN_PASSWORD=""

# Optional Supabase Configuration (for external PostgreSQL / Storage / Auth deployment)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Image-to-3D AI Conversion Service (3D Evidence Studio)
# Configure ONE of the supported real Image-to-3D providers (server-side only):
# 1. Meshy AI Image-to-3D API (https://api.meshy.ai)
MESHY_API_KEY=""
# 2. Tripo3D Image-to-3D API (https://api.tripo3d.ai)
TRIPO_API_KEY=""
# 3. Custom Image-to-3D REST endpoint returning GLB/GLTF output
IMAGE_TO_3D_API_URL=""
IMAGE_TO_3D_API_KEY=""

